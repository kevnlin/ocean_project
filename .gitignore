# --- Large data (regenerate; not tracked in git) ---
# raw CESM2-LE / WOA23 NetCDF (~4.7 GB)
/data/
# standardized Zarr stores (~42 GB) — regenerate via experiments/standardize.py
/processed/

# --- Large per-cell prediction arrays exceed GitHub's 100 MB file limit ---
# Their RMSE summaries (predictions/*_rmse.csv, reports/) and the checkpoints that
# produce them ARE tracked; regenerate the arrays with src/baselines/*.py.
/predictions/*.npz

# --- Runtime artifacts ---
/outputs/*.log
/outputs/*.pid
# Root-level run logs from long experiment jobs (same intent as /outputs/*.log);
# the numbers they contain are persisted in outputs/cache/*.json.
/logs_*.log
/outputs/logs/
/outputs/cache/synthetic_argo_example.npz
# Pseudo-SSH archive: 360 monthly (180,360) fields, ~90 MB — regenerate with
# experiments/28_make_ssh.py (its *_meta.json diagnostics ARE tracked).
/outputs/cache/ssh_dyn*.npz
# Local safety copies written by merge_density_json.py before it first edits a
# committed cache. The pre-merge state is already in git history, so these are
# belt-and-braces for an uncommitted tree only.
/outputs/cache/*.bak_premerge
/outputs/cache/*.bak_week2

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
*.swp
