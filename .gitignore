# --- Large data (regenerate; not tracked in git) ---
# raw CESM2-LE / WOA23 NetCDF (~4.7 GB)
/data/
# standardized Zarr stores (~42 GB) — regenerate via experiments/data/standardize.py
/processed/

# --- Large per-cell prediction arrays exceed GitHub's 100 MB file limit ---
# Their RMSE summaries (predictions/*_rmse.csv, reports/) and the checkpoints that
# produce them ARE tracked; regenerate the arrays with src/baselines/*.py.
/predictions/*.npz

# --- Runtime artifacts ---
/outputs/*.log
# GODAS row checkpoints: many small .pt files, regenerate with 14_godas_dfs_d4rt.py
/outputs/godas*/**/*.pt
/outputs/godas*/*.pt
/outputs/*.pid
# Root-level run logs from long experiment jobs (same intent as /outputs/*.log
# GODAS row checkpoints: many small .pt files, regenerate with 14_godas_dfs_d4rt.py
/outputs/godas*/**/*.pt
/outputs/godas*/*.pt);
# the numbers they contain are persisted in outputs/cache/*.json.
/logs_*.log
# Per-run stdout from long jobs launched into logs/<arm>/ (same intent).
/logs/
/outputs/logs/
/outputs/cache/synthetic_argo_example.npz
# Pseudo-SSH archive: 360 monthly (180,360) fields, ~90 MB — regenerate with
# experiments/synthetic/28_make_ssh.py (its *_meta.json diagnostics ARE tracked).
/outputs/cache/ssh_dyn*.npz
# Local safety copies written by merge_density_json.py before it first edits a
# committed cache. The pre-merge state is already in git history, so these are
# belt-and-braces for an uncommitted tree only.
/outputs/cache/*.bak_premerge
/outputs/cache/*.bak_week2

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
*.swp

# --- Real-observation ingest & external code (regenerate; not tracked) ---
# Argo GDAC floats (~9.7 GB), QC'd cohort, EN4/ECCO subsets and the NOAA weekly
# file the Senseiver reproduction rebuilds live under /data/, already ignored.
# Upstream clones + the ~1 GB sst_weekly.mat built for the official example:
/external/
# Real-Argo row checkpoints: many small .pt files, regenerate with
# experiments/real_data/45_argo_real_data.py (the signed artifact_*.json ARE tracked).
/outputs/argo_*/*.pt

# --- Audit runs (2026-09-17 pipeline audit) ---
# Per-arm weights and the raw step-by-step histories regenerate with
# experiments/real_data/62_sanity_train.py; the summary_seed*.json each run
# writes ARE small and are what 63_audit_report.py reads.
/outputs/audit/**/*.pt
/outputs/audit/**/history.jsonl
# W&B offline runs (sync with: wandb sync outputs/wandb/wandb/offline-run-*)
/outputs/wandb/
# Exact-position anomaly cache, rebuilt by audit_tools.load_cohort(anomaly="exact")
/data/argo_cohort/*_anomx.npz
